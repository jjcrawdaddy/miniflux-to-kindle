MINIFLUX_BASE_URL=http://localhost:8080
MINIFLUX_API_KEY=your-miniflux-api-key
# Select sources: at least one of MINIFLUX_FEED_IDS or MINIFLUX_CATEGORY_IDS.
MINIFLUX_FEED_IDS=55,12,7
# MINIFLUX_CATEGORY_IDS=4

# SMTP delivery (Gmail example). For another provider, change these to its
# host/port/security. GMAIL_USER / GMAIL_APP_PASSWORD still work as fallbacks
# for SMTP_USER / SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=you@gmail.com
# starttls (default) | ssl | none
SMTP_SECURITY=starttls
# Attachment MIME type(s) to try, in order. Some relays (e.g. Scaleway TEM)
# reject application/epub+zip; add fallbacks and keep the .epub filename so the
# Kindle can still identify the file.
#SMTP_ATTACHMENT_MIME=application/epub+zip,application/xml

KINDLE_EMAIL=you@kindle.com
DIGEST_HOUR=6
TIMEZONE=America/Chicago
# Send a digest immediately when the container starts (default true);
# set false to only send at the scheduled hour
RUN_ON_STARTUP=true
# Mark included entries as read in Miniflux after a successful send (default
# true); set false to leave them unread (e.g. when testing against a real instance)
MARK_AS_READ=true
# Optional: healthchecks.io ping URL; pings /start, success, and /fail per cycle
#HEALTHCHECK_URL=https://hc-ping.com/your-check-uuid
